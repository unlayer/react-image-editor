{
  "name": "@unlayer/react-image-editor",
  "version": "1.0.2",
  "description": "Unlayer's Image Editor Component for React.js",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0"
    }
  },
  "packageManager": "pnpm@11.20.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "tsup --watch",
    "dev": "pnpm --dir demo run dev",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run lint && pnpm run typecheck && pnpm test",
    "release": "pnpm run build && pnpm publish"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@unlayer/types": "1.477.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tsup": "8.5.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "author": "Unlayer",
  "homepage": "https://github.com/unlayer/react-image-editor#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unlayer/react-image-editor.git"
  },
  "keywords": [
    "react",
    "react-component",
    "image",
    "image-editor",
    "photo-editor",
    "image-editing",
    "unlayer"
  ]
}
